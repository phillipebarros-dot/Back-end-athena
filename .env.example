# ============================================================================
# Athena Backend — Variáveis de Ambiente
# ============================================================================

# === Server ===
PORT=8080
DEBUG=false
HOST=0.0.0.0

# === BigQuery ===
# Projeto para tools de mídia (BigQuery consultas do agente)
BQ_PROJECT_ID=athenaai-opus
# Projeto para persistência (conversations, messages, feedback, logs, learnings)
BQ_PROJECT_PERSISTENCE=sheetsintegration-451500
BQ_DATASET_MEDIA=ath_boticario
BQ_DATASET_PERSISTENCE=pj_boti
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# === LLM (Anthropic) ===
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL_MAIN=claude-sonnet-4-6
LLM_TEMPERATURE_MAIN=0.15
LLM_MAX_TOKENS_MAIN=4096
LLM_MODEL_SUMMARIZER=claude-haiku-4-5
LLM_MAX_ITERATIONS=20

# === MCP Servers (Camilo — 4 serviços no Cloud Run) ===
MCP_PUBLI_URL=https://mcp-publi-mysql-642859299503.us-central1.run.app/mcp
MCP_PESQUISAS_URL=https://mcp-pesquisas-642859299503.us-central1.run.app/mcp
MCP_EXPORT_URL=https://mcp-export-642859299503.us-central1.run.app/mcp
MCP_MIDIA_ONLINE_URL=https://mcp-midia-online-642859299503.us-central1.run.app/mcp
MCP_AUTH_TOKEN=your-token-here

# === PostgreSQL — Cloud SQL (LangGraph Checkpointer + Athena schema) ===
# Instância: db-sql-om:us-central1:pg-grom (PostgreSQL 18)
# Opção 1: URI direta (requer IP liberado ou Cloud SQL Proxy)
POSTGRES_URI=
# Opção 2: Cloud SQL Connector (recomendado pra Cloud Run)
CLOUDSQL_INSTANCE=db-sql-om:us-central1:pg-grom
CLOUDSQL_USER=athena_user
CLOUDSQL_PASSWORD=your-password-here
CLOUDSQL_DB=postgres
# SA para Cloud SQL API (caminho do JSON — usado pelo Connector)
CLOUDSQL_SA_KEY=db-sql-om-service-account.json

# === TTS (OpenAI) ===
OPENAI_API_KEY=sk-...
TTS_MODEL=tts-1
TTS_VOICE=nova

# === Segurança ===
ADMIN_EMAILS=andrei@grupoom.com.br,phillipe.barros@grupoom.com.br,camilo.ferreira@grupoom.com.br,gabriel.oliveira@grupoom.com.br
RATE_LIMIT_PER_MINUTE=30
MAX_INPUT_CHARS=4000

# === CORS ===
# URL(s) do frontend, separadas por vírgula. Obrigatório em produção.
CORS_ALLOWED_ORIGINS=https://athena-frontend-XXXXXX.us-central1.run.app

# === Observabilidade (opcional) ===
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_PROJECT=athena-backend
